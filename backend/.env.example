PORT=3001
NODE_ENV=development
LOG_LEVEL=info
DATABASE_URL=./data/alice.db
CORS_ORIGINS=http://localhost:3000

# WebAuthn / passkeys
WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_NAME=Alice
WEBAUTHN_ORIGIN=http://localhost:3000

# Sessions
SESSION_TTL_HOURS=720

# Rate limiting: set true only behind a reverse proxy you control
TRUST_PROXY=false

# Encrypts stored Home Assistant tokens. Required to save a connection.
# Generate one with: openssl rand -base64 32
SECRETS_KEY=

# Keeps the Home Assistant admin token away from this server. Generate all keys with: bun run keys:generate
# The main server gets the PUBLIC key (it can store the admin token but never read it).
ADMIN_SEAL_PUBLIC_KEY=
# Config-worker only (do not set on the main server):
# ADMIN_SEAL_PRIVATE_KEY=

# Push notifications to phones and browsers (all optional; generate VAPID keys with: bun run keys:generate)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
# Firebase (Android and iOS apps): base64 of your service account JSON key file
FCM_SERVICE_ACCOUNT=

# Backups of Alice's own database. A key is recommended (generate with: bun run keys:generate); without one backups are plain compressed files.
BACKUP_ENCRYPTION_KEY=
# BACKUP_DIR=./data/backups

# Where Alice learns about new versions: a JSON file {"version":"0.2.0","notes":"..."}. Leave empty for none.
UPDATE_MANIFEST_URL=
# Ed25519 public key of whoever publishes releases (bun run keys:generate). With it, unsigned manifests are rejected.
UPDATE_SIGNING_PUBLIC_KEY=
# UPDATE_ALLOW_UNSIGNED=false

# Optional: Ask Alice asks Claude when its own rules find nothing. Sends device and room names and the typed sentence to Anthropic.
AI_API_KEY=
# AI_MODEL=claude-haiku-5-5
