\"7\\\" width=\\\"18\\\" height=\\\"12\\\" rx=\\\"3\\\"/><circle cx=\\\"12\\\" cy=\\\"13\\\" r=\\\"3.2\\\"/><path d=\\\"M8 7l1.2-2h5.6L16 7\\\"/>\",\n  door: \"<path d=\\\"M6 21V4a1 1 0 0 1 1-1h10a1 1 0 0 1 1 1v17M4 21h16\\\"/><path d=\\\"M15 12.5h.01\\\"/>\",\n  moon: \"<path d=\\\"M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5z\\\"/>\",\n  sun: \"<circle cx=\\\"12\\\" cy=\\\"12\\\" r=\\\"4\\\"/><path d=\\\"M12 2v2.5M12 19.5V22M2 12h2.5M19.5 12H22M4.9 4.9l1.8 1.8M17.3 17.3l1.8 1.8M4.9 19.1l1.8-1.8M17.3 6.7l1.8-1.8\\\"/>\",\n  exit: \"<path d=\\\"M10 4H6a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h4M15 8l4 4-4 4M19 12H9\\\"/>\",\n  bag: \"<rect x=\\\"5\\\" y=\\\"8\\\" width=\\\"14\\\" height=\\\"12\\\" rx=\\\"2.5\\\"/><path d=\\\"M9 8V5.5A1.5 1.5 0 0 1 10.5 4h3A1.5 1.5 0 0 1 15 5.5V8M9 8v12M15 8v12\\\"/>\",\n  bolt: \"<path d=\\\"M13 3L5 13.5h6L10 21l8-10.5h-6z\\\"/>\",\n  bell: \"<path d=\\\"M6 16v-5a6 6 0 0 1 12 0v5l1.5 2h-15zM10 20.5a2 2 0 0 0 4 0\\\"/>\",\n  users: \"<circle cx=\\\"9\\\" cy=\\\"9\\\" r=\\\"3.2\\\"/><path d=\\\"M3 20c.5-3.2 3-5 6-5s5.5 1.8 6 5M16 6.3a3 3 0 0 1 0 5.4M18 15.2c1.8.6 3 2.2 3.3 4.8\\\"/>\",\n  user: \"<circle cx=\\\"12\\\" cy=\\\"8.5\\\" r=\\\"3.5\\\"/><path d=\\\"M5 20c.7-3.6 3.4-5.5 7-5.5s6.3 1.9 7 5.5\\\"/>\",\n  search: \"<circle cx=\\\"11\\\" cy=\\\"11\\\" r=\\\"6.5\\\"/><path d=\\\"M16 16l4.5 4.5\\\"/>\",\n  star: \"<path d=\\\"M12 3.5l2.6 5.4 5.9.8-4.3 4.1 1.1 5.9L12 16.9 6.7 19.7l1.1-5.9L3.5 9.7l5.9-.8z\\\"/>\",\n  plus: \"<path d=\\\"M12 5v14M5 12h14\\\"/>\",\n  minus: \"<path d=\\\"M5 12h14\\\"/>\",\n  check: \"<path d=\\\"M5 12.5l4.5 4.5L19 7.5\\\"/>\",\n  x: \"<path d=\\\"M6 6l12 12M18 6L6 18\\\"/>\",\n  alert: \"<path d=\\\"M12 4l9 16H3z\\\"/><path d=\\\"M12 10v4M12 17v.2\\\"/>\",\n  clock: \"<circle cx=\\\"12\\\" cy=\\\"12\\\" r=\\\"8.5\\\"/><path d=\\\"M12 7.5V12l3 2\\\"/>\",\n  server: \"<rect x=\\\"4\\\" y=\\\"4\\\" width=\\\"16\\\" height=\\\"6.5\\\" rx=\\\"2\\\"/><rect x=\\\"4\\\" y=\\\"13.5\\\" width=\\\"16\\\" height=\\\"6.5\\\" rx=\\\"2\\\"/><path d=\\\"M8 7.2h.01M8 16.8h.01\\\"/>\",\n  disk: \"<path d=\\\"M4 14l2.5-8h11L20 14M4 14v4a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-4zM8 17h.01\\\"/>\",\n  refresh: \"<path d=\\\"M20 11a8 8 0 0 0-14.5-3.5M4 13a8 8 0 0 0 14.5 3.5M5 4v4h4M19 20v-4h-4\\\"/>\",\n  key: \"<circle cx=\\\"8\\\" cy=\\\"15\\\" r=\\\"3.5\\\"/><path d=\\\"M10.5 12.5L20 3M16 7l3 3M13.5 9.5l2 2\\\"/>\",\n  finger: \"<path d=\\\"M6 11a6 6 0 0 1 12 0M12 11v3c0 3 .5 4.5 1.5 6M8.5 20c-1-2-1-4-1-6a4.5 4.5 0 0 1 9 0c0 2 .3 3.6 1 5M12 8a3 3 0 0 0-3 3\\\"/>\",\n  copy: \"<rect x=\\\"8\\\" y=\\\"8\\\" width=\\\"11\\\" height=\\\"11\\\" rx=\\\"2.5\\\"/><path d=\\\"M16 8V6a2 2 0 0 0-2-2H7a2 2 0 0 0-2 2v7a2 2 0 0 0 2 2h1\\\"/>\",\n  chev: \"<path d=\\\"M9 6l6 6-6 6\\\"/>\",\n  sparkle: \"<path d=\\\"M12 3l1.8 5.2L19 10l-5.2 1.8L12 17l-1.8-5.2L5 10l5.2-1.8zM18.5 16l.8 2.2 2.2.8-2.2.8-.8 2.2-.8-2.2-2.2-.8 2.2-.8z\\\"/>\",\n  play: \"<path d=\\\"M8 5.5v13l11-6.5z\\\"/>\",\n  cloud: \"<path d=\\\"M7 18a4.5 4.5 0 0 1-.6-8.96A6 6 0 0 1 18 10.5 3.8 3.8 0 0 1 17.5 18z\\\"/>\",\n  mic: \"<rect x=\\\"9\\\" y=\\\"3\\\" width=\\\"6\\\" height=\\\"11\\\" rx=\\\"3\\\"/><path d=\\\"M5.5 11a6.5 6.5 0 0 0 13 0M12 17.5V21\\\"/>\",\n  pulse: \"<path d=\\\"M3 12h4l2-6 4 12 2-6h6\\\"/>\",\n  trash: \"<path d=\\\"M5 7h14M10 7V4h4v3M7 7l1 13h8l1-13\\\"/>\",\n  wifi: \"<path d=\\\"M3 9a13 13 0 0 1 18 0M6 12.5a8.5 8.5 0 0 1 12 0M9 16a4 4 0 0 1 6 0M12 19.5h.01\\\"/>\",\n  download: \"<path d=\\\"M12 4v11M7 11l5 5 5-5M5 20h14\\\"/>\",\n  eye: \"<path d=\\\"M2.5 12S6 5.5 12 5.5 21.5 12 21.5 12 18 18.5 12 18.5 2.5 12 2.5 12z\\\"/><circle cx=\\\"12\\\" cy=\\\"12\\\" r=\\\"2.8\\\"/>\",\n  layers: \"<path d=\\\"M12 4l9 5-9 5-9-5zM3 14l9 5 9-5\\\"/>\",\n  rocket: \"<path d=\\\"M12 3c3 2 5 5 5 9l-2 3H9l-2-3c0-4 2-7 5-9zM9 18l-1 3 4-2 4 2-1-3M12 10h.01\\\"/>\",\n  note: \"<path d=\\\"M6 4h9l3 3v13H6zM9 11h6M9 15h6\\\"/>\",\n} satisfies Record<string, string>;\n\n/** Solid forms, used for the selected tab. Open strokes inside carry fill=\"none\" so only the closed shapes fill. */\nexport const FILLED: Record<string, string> = {\n  home: PATHS.home,\n  grid: PATHS.grid,\n  flow: '<circle cx=\"6\" cy=\"6\" r=\"2.5\"/><circle cx=\"18\" cy=\"12\" r=\"2.5\"/><circle cx=\"6\" cy=\"18\" r=\"2.5\"/><path fill=\"none\" d=\"M8.5 6H11a4 4 0 0 1 4 4v.5M8.5 18H11a4 4 0 0 0 4-4v-.5\"/>',\n  shield: PATHS.shield,\n};\n\n/** Every icon name, for autocomplete and checking. */\nexport type IconName = keyof typeof PATHS;\n"
